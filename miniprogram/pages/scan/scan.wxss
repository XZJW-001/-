.scan-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.scan-panel {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.scan-box {
  position: relative;
  width: 100%;
  height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-soft);
}

.scan-line {
  position: absolute;
  top: 46rpx;
  left: 36rpx;
  right: 36rpx;
  z-index: 2;
  height: 3rpx;
  background: var(--color-primary);
  box-shadow: 0 0 14rpx rgba(29, 78, 216, 0.35);
  animation: scan-line 2.2s ease-in-out infinite;
}

.scan-corner {
  position: absolute;
  width: 54rpx;
  height: 54rpx;
  border-color: var(--color-primary);
  border-style: solid;
  border-width: 0;
}

.scan-corner.tl { top: 28rpx; left: 28rpx; border-top-width: 5rpx; border-left-width: 5rpx; }
.scan-corner.tr { top: 28rpx; right: 28rpx; border-top-width: 5rpx; border-right-width: 5rpx; }
.scan-corner.bl { bottom: 28rpx; left: 28rpx; border-bottom-width: 5rpx; border-left-width: 5rpx; }
.scan-corner.br { right: 28rpx; bottom: 28rpx; border-right-width: 5rpx; border-bottom-width: 5rpx; }

.scan-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scan-symbol {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #D9E5FF;
  border-radius: var(--radius-base);
  background: var(--color-primary-bg);
}

.scan-tip-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.scan-tip-text {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.scan-primary,
.scan-reset {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-base);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.scan-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(29, 78, 216, 0.18);
}

.scan-reset {
  border: 1rpx solid var(--border-light);
  background: var(--bg-white);
  color: var(--text-regular);
}

.result-area {
  margin-bottom: 32rpx;
  padding: 26rpx;
  border: 1rpx solid #CDEFE5;
  border-left: 6rpx solid var(--color-success);
  border-radius: var(--radius-base);
  background: var(--bg-white);
}

.result-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-success);
  font-size: 26rpx;
  font-weight: 600;
}

.status-mark {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-success);
  color: #fff;
  font-size: 20rpx;
}

.result-content {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: var(--radius-small);
  background: var(--bg-soft);
  color: var(--text-regular);
  font-size: 24rpx;
  word-break: break-all;
}

.section-desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.action-grid {
  overflow: hidden;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-extra-light);
}

.action-item:last-child {
  border-bottom: 0;
}

.action-item:active {
  background: var(--bg-soft);
}

.action-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-base);
  font-size: 26rpx;
  font-weight: 650;
}

.action-mark.photo { background: var(--color-primary-bg); color: var(--color-primary); }
.action-mark.location { background: var(--color-success-bg); color: var(--color-success); }
.action-mark.gesture { background: var(--color-warning-bg); color: var(--color-warning); }
.action-mark.qrcode { background: var(--color-info-bg); color: var(--color-info); }

.action-copy {
  flex: 1;
  min-width: 0;
}

.action-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.action-desc {
  margin-top: 5rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.action-arrow {
  color: var(--text-placeholder);
  font-size: 38rpx;
  font-weight: 300;
}

@keyframes scan-line {
  0%, 100% { transform: translateY(0); opacity: 0.75; }
  50% { transform: translateY(330rpx); opacity: 1; }
}
