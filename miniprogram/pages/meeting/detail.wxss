/* pages/meeting/detail.wxss */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e4e7ed;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.card {
  background: #fff;
  border-radius: var(--radius-base);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-base);
}

/* ========== 查看会议 ========== */
.meeting-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.meeting-header .meeting-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
}

.meeting-desc {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  margin-bottom: 24rpx;
}

.info-grid .info-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 78rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-extra-light);
  font-size: 26rpx;
}

.info-grid .info-item:last-child {
  border-bottom: 0;
}

.info-grid .info-item .info-icon {
  margin-right: 12rpx;
}

.info-grid .info-item .info-label {
  width: 126rpx;
  flex-shrink: 0;
  color: var(--text-secondary);
}

.info-grid .info-item .info-value {
  min-width: 0;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.methods-section {
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border-extra-light);
}

.methods-section .section-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.methods-section .method-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-base);
  font-size: 24rpx;
}

.tag-warning { background: var(--color-warning-bg); color: var(--color-warning); }
.tag-success { background: var(--color-success-bg); color: var(--color-success); }
.tag-info { background: var(--color-info-bg); color: var(--color-info); }
.tag-primary { background: var(--color-primary-bg); color: var(--color-primary); }

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  border-top: 1rpx solid var(--border-extra-light);
}

.stat-item {
  position: relative;
  flex: 1;
  padding: 26rpx 6rpx 0;
  text-align: center;
}

.stat-item:not(:last-child)::after {
  position: absolute;
  top: 28rpx;
  right: 0;
  width: 1rpx;
  height: 60rpx;
  background: var(--border-extra-light);
  content: '';
}

.stat-item .stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.stat-item.success .stat-value { color: var(--color-success); }
.stat-item.warning .stat-value { color: var(--color-warning); }
.stat-item.danger .stat-value { color: var(--color-danger); }

.stat-item .stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-section .progress-bar {
  height: 20rpx;
  background: var(--border-extra-light);
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-section .progress-bar .progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 10rpx;
  transition: width 0.3s;
}

.progress-section .progress-text {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.action-section {
  display: grid;
  gap: 16rpx;
  padding: 8rpx 0 20rpx;
}

/* ========== 创建会议表单 ========== */
.meeting-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.meeting-heading-row .page-title {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.meeting-heading-row .tag {
  flex-shrink: 0;
  margin-top: 6rpx;
}

.form-card {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 14rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid var(--border-light);
  background: var(--bg-soft);
  border-radius: var(--radius-base);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  border: 1rpx solid var(--border-light);
  background: var(--bg-soft);
  border-radius: var(--radius-base);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-row picker {
  flex: 1;
}

/* 签到时间快捷设置 */
.checkin-mode-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 16rpx;
  padding: 6rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-soft);
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-small);
  background: transparent;
  font-size: 26rpx;
  color: var(--text-regular);
}
.mode-tab.active {
  background: var(--bg-white);
  color: var(--color-primary);
  box-shadow: var(--shadow-base);
  font-weight: 600;
}
.offset-box {
  border: 1rpx solid var(--border-extra-light);
  background: var(--bg-soft);
  border-radius: var(--radius-base);
  padding: 20rpx 24rpx;
}
.offset-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #303133;
  padding: 10rpx 0;
}
.offset-line:first-child {
  margin-bottom: 8rpx;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 8rpx;
  background: var(--bg-white);
  font-size: 32rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--border-light);
}
.step-val {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid var(--border-light);
  background: var(--bg-soft);
  border-radius: var(--radius-base);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 签到方式 chips */
.method-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.method-chip {
  padding: 14rpx 30rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-small);
  font-size: 26rpx;
  color: var(--text-regular);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.method-chip.checked {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* 按钮 */
.btn-block {
  width: 100%;
  margin-bottom: 0;
}

.btn-cancel {
  border: 1rpx solid var(--border-light);
  background: var(--bg-white);
  color: var(--text-regular);
}

.btn-disabled {
  background: #c0c4cc;
  color: #fff;
}
