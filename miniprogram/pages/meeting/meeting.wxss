/* pages/meeting/meeting.wxss */
.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.top-bar .filter-tabs {
  flex: 1;
  margin-bottom: 0;
}

.top-bar .create-btn {
  background: var(--color-primary);
  color: white;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-base);
  font-size: 26rpx;
  white-space: nowrap;
}

.filter-tabs {
  display: flex;
  background: #fff;
  border-radius: var(--radius-base);
  padding: 8rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-base);
}

.filter-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #606266;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.filter-tabs .tab-item.active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-weight: 500;
}

.meeting-list .meeting-card {
  background: #fff;
  border-radius: var(--radius-base);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-base);
}

.meeting-list .meeting-card .card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.meeting-list .meeting-card .card-header .meeting-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
}

.meeting-list .meeting-card .card-body .info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.meeting-list .meeting-card .card-body .info-row .icon {
  margin-right: 12rpx;
}

.meeting-list .meeting-card .card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-extra-light);
  display: flex;
  justify-content: flex-end;
}

.meeting-list .meeting-card .card-footer .btn-sign {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-base);
  font-size: 26rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-state .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-state text {
  color: #909399;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  border-radius: var(--radius-large);
  padding: 40rpx;
  width: 650rpx;
  z-index: 1001;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: var(--radius-base);
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  align-items: center;
  line-height: 88rpx;
  color: #606266;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-base);
  font-size: 30rpx;
}

.btn-cancel {
  background: #f5f7fa;
  color: #606266;
}

.btn-confirm {
  background: var(--color-primary);
  color: white;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #606266;
}
