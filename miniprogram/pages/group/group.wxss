.group-page {
  min-height: 100vh;
  padding: 36rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  background: var(--bg-base);
}

.page-intro {
  margin-bottom: 28rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.page-title {
  color: var(--text-primary);
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.25;
}

.page-desc,
.section-desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-count {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-small);
  background: var(--bg-white);
  color: var(--text-secondary);
  font-size: 22rpx;
}

.overview-band {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx 10rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.metric-item {
  flex: 1;
  padding: 0 24rpx;
}

.metric-value {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.2;
}

.metric-value.success {
  color: var(--color-success);
}

.metric-label {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.metric-divider {
  width: 1rpx;
  height: 64rpx;
  background: var(--border-light);
}

.workspace-tools {
  margin-bottom: 32rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.search-bar {
  display: flex;
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid var(--border-base);
  border-radius: var(--radius-base);
  background: var(--bg-soft);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 22rpx;
  color: var(--text-primary);
  font-size: 26rpx;
}

.search-placeholder {
  color: var(--text-placeholder);
}

.search-btn {
  width: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-left: 1rpx solid var(--border-base);
  background: var(--bg-white);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.tool-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.tool-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-soft);
  color: var(--text-regular);
  font-size: 26rpx;
  font-weight: 500;
}

.tool-btn.primary {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #fff;
}

.tool-symbol {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.group-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 26rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.group-item:active {
  border-color: #B8CCFA;
  background: var(--bg-soft);
}

.group-avatar {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #D9E5FF;
  border-radius: var(--radius-base);
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 650;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-desc {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.meta-item {
  padding: 5rpx 10rpx;
  border-radius: var(--radius-small);
  background: var(--color-info-bg);
  color: var(--color-info);
  font-size: 20rpx;
}

.meta-item.code {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.group-arrow {
  flex-shrink: 0;
  color: var(--text-placeholder);
  font-size: 38rpx;
  font-weight: 300;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(16, 24, 40, 0.5);
}

.modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1001;
  width: 638rpx;
  padding: 36rpx;
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: 0 40rpx 100rpx rgba(16, 24, 40, 0.22);
  transform: translate(-50%, -50%);
}

.modal-title {
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 650;
}

.modal-desc {
  margin: 8rpx 0 30rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.modal-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 34rpx;
}

.code-input {
  font-size: 34rpx;
  font-weight: 600;
}
