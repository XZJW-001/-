.smart-page { padding-bottom: calc(50rpx + env(safe-area-inset-bottom)); }
.score-band { display: grid; grid-template-columns: 1.35fr .65fr; margin-bottom: 20rpx; overflow: hidden; border-radius: var(--radius-base); background: #18212f; color: #fff; }
.score-main { display: flex; flex-direction: column; gap: 8rpx; padding: 34rpx; border-right: 1rpx solid rgba(255,255,255,.12); }
.score-main text { color: #aeb9c8; font-size: 23rpx; }.score-main strong { font-size: 70rpx; line-height: 1; }.score-main span { color: #8fa0b5; font-size: 20rpx; }
.score-side { display: grid; grid-template-rows: 1fr 1fr; }.score-side view { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5rpx; }.score-side view:first-child { border-bottom: 1rpx solid rgba(255,255,255,.12); }.score-side strong { font-size: 30rpx; }.score-side span { color: #9dacbe; font-size: 20rpx; }
.metric-row { display: grid; grid-template-columns: repeat(4,1fr); margin-bottom: 24rpx; background: #fff; border: 1rpx solid var(--border-light); border-radius: var(--radius-base); }
.metric-item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5rpx; padding: 24rpx 8rpx; }.metric-item:not(:last-child)::after { position:absolute; right:0; top:24rpx; width:1rpx; height:58rpx; background:var(--border-lighter); content:''; }.metric-item strong { color:var(--color-primary); font-size:34rpx; }.metric-item span { color:var(--text-secondary); font-size:21rpx; }.metric-item.success strong { color:var(--color-success); }.metric-item.warning strong { color:var(--color-warning); }.metric-item.danger strong { color:var(--color-danger); }
.offline-panel { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.offline-copy { min-width:0; }.sync-button { min-width:112rpx; padding:18rpx 20rpx; border:1rpx solid var(--border-light); border-radius:var(--radius-small); color:var(--text-placeholder); text-align:center; font-size:24rpx; }.sync-button.active { border-color:#b8ccfa; background:var(--color-primary-bg); color:var(--color-primary); font-weight:600; }
.reminder-list { border-top:1rpx solid var(--border-extra-light); }.reminder-item { display:flex; align-items:flex-start; gap:16rpx; padding:24rpx 0; border-bottom:1rpx solid var(--border-extra-light); }.reminder-item:last-child { border-bottom:0; }.reminder-item.read { opacity:.62; }.reminder-dot { width:14rpx; height:14rpx; flex:0 0 14rpx; margin-top:12rpx; border-radius:50%; background:var(--color-primary); box-shadow:0 0 0 6rpx var(--color-primary-bg); }.reminder-item.read .reminder-dot { background:var(--border-base); box-shadow:none; }.reminder-copy { flex:1; min-width:0; }.reminder-title { color:var(--text-primary); font-size:27rpx; font-weight:600; }.reminder-text { margin-top:7rpx; color:var(--text-regular); font-size:23rpx; line-height:1.5; }.reminder-meta { margin-top:8rpx; color:var(--text-placeholder); font-size:20rpx; }.menu-arrow { align-self:center; color:var(--text-placeholder); font-size:36rpx; }
.trend-list { display:grid; gap:20rpx; }.trend-row { display:grid; grid-template-columns:100rpx 1fr 70rpx; align-items:center; gap:16rpx; color:var(--text-secondary); font-size:22rpx; }.trend-row strong { color:var(--text-primary); text-align:right; }.trend-track { height:12rpx; overflow:hidden; border-radius:8rpx; background:var(--color-info-bg); }.trend-fill { height:100%; border-radius:8rpx; background:var(--color-success); }.empty-box.compact { min-height:120rpx; padding:20rpx; }
