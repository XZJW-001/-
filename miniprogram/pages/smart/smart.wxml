<view class="smart-page page-shell">
  <view class="page-heading">
    <text class="page-kicker">个人出勤</text>
    <view class="page-title">智慧中心</view>
    <view class="page-desc">出勤表现、会议提醒与弱网记录</view>
  </view>

  <view class="score-band">
    <view class="score-main">
      <text>出勤可信度</text>
      <strong>{{profile.reliabilityScore || 0}}</strong>
      <span>综合签到率、迟到和缺席情况</span>
    </view>
    <view class="score-side">
      <view><strong>{{profile.attendanceRate || 0}}%</strong><span>签到率</span></view>
      <view><strong>{{profile.continuousAttendance || 0}}</strong><span>连续正常</span></view>
    </view>
  </view>

  <view class="metric-row">
    <view class="metric-item"><strong>{{profile.totalMeetings || 0}}</strong><span>参会</span></view>
    <view class="metric-item success"><strong>{{profile.normalCount || 0}}</strong><span>正常</span></view>
    <view class="metric-item warning"><strong>{{profile.lateCount || 0}}</strong><span>迟到</span></view>
    <view class="metric-item danger"><strong>{{profile.absenceCount || 0}}</strong><span>缺席</span></view>
  </view>

  <view class="section-card offline-panel">
    <view class="offline-copy">
      <view class="section-title">弱网签到</view>
      <view class="section-desc">待同步 {{offlineCount}} 条 · 恢复网络后自动提交</view>
    </view>
    <view class="sync-button {{offlineCount ? 'active' : ''}}" bindtap="syncOffline">同步</view>
  </view>

  <view class="section-card">
    <view class="section-heading">
      <view>
        <view class="section-title">会议提醒</view>
        <view class="section-desc">未读与近期会议消息</view>
      </view>
      <view class="tag tag-primary">{{reminders.length}}</view>
    </view>
    <view wx:if="{{reminders.length}}" class="reminder-list">
      <view
        wx:for="{{reminders}}"
        wx:key="id"
        class="reminder-item {{item.read ? 'read' : ''}}"
        bindtap="openReminder"
        data-item="{{item}}"
      >
        <view class="reminder-dot"></view>
        <view class="reminder-copy">
          <view class="reminder-title">{{item.meetingTitle || '会议提醒'}}</view>
          <view class="reminder-text">{{item.content}}</view>
          <view class="reminder-meta">{{item.location || '地点待定'}} · {{item.startTime || ''}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view wx:else class="empty-box">暂无会议提醒</view>
  </view>

  <view class="section-card">
    <view class="section-heading compact">
      <view class="section-title">近六个月趋势</view>
    </view>
    <view wx:if="{{profile.monthlyTrend && profile.monthlyTrend.length}}" class="trend-list">
      <view wx:for="{{profile.monthlyTrend}}" wx:key="month" class="trend-row">
        <text>{{item.month}}</text>
        <view class="trend-track"><view class="trend-fill" style="width: {{item.total ? item.attended * 100 / item.total : 0}}%"></view></view>
        <strong>{{item.attended}}/{{item.total}}</strong>
      </view>
    </view>
    <view wx:else class="empty-box compact">暂无趋势数据</view>
  </view>
</view>
