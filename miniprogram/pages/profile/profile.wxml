<view class="profile-page page-shell">
  <view class="page-heading">
    <text class="page-kicker">账号与数据</text>
    <view class="page-title">个人中心</view>
    <view class="page-desc">查看个人资料、签到表现与常用功能</view>
  </view>

  <view class="profile-panel" wx:if="{{userInfo}}">
    <view class="avatar">
      <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill" />
      <text wx:else>{{userInfo.realName ? userInfo.realName[0] : 'U'}}</text>
    </view>
    <view class="user-info">
      <view class="user-name">{{userInfo.realName || userInfo.username}}</view>
      <view class="user-account">{{userInfo.username}} · {{userInfo.position || '普通用户'}}</view>
    </view>
    <view class="account-status"><text class="status-dot"></text>已登录</view>
  </view>

  <view class="profile-panel signed-out" wx:else>
    <view class="avatar muted">?</view>
    <view class="user-info">
      <view class="user-name">未登录</view>
      <view class="user-account">登录后查看个人签到数据</view>
    </view>
    <view class="login-link" bindtap="handleLogin">去登录</view>
  </view>

  <view class="section-card stats-card" wx:if="{{userInfo}}">
    <view class="section-heading">
      <view>
        <view class="section-title">我的签到</view>
        <view class="section-desc">个人出勤情况汇总</view>
      </view>
      <view class="more" bindtap="goToStatistics">查看明细 ›</view>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{myStats.totalMeetings || 0}}</view>
        <view class="stat-label">参加会议</view>
      </view>
      <view class="stat-item success">
        <view class="stat-value">{{myStats.signedCount || 0}}</view>
        <view class="stat-label">正常签到</view>
      </view>
      <view class="stat-item warning">
        <view class="stat-value">{{myStats.lateCount || 0}}</view>
        <view class="stat-label">迟到</view>
      </view>
      <view class="stat-item rate">
        <view class="stat-value">{{myStats.attendanceRate || 0}}%</view>
        <view class="stat-label">出勤率</view>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{userInfo}}">
    <view class="section-heading compact">
      <view class="section-title">个人资料</view>
    </view>
    <view class="info-list">
      <view class="info-row">
        <text class="info-label">用户名</text>
        <text class="info-value">{{userInfo.username}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">邮箱</text>
        <text class="info-value">{{userInfo.email || '未绑定'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">所属部门</text>
        <text class="info-value">{{userInfo.deptId ? '部门 ' + userInfo.deptId : '未分配'}}</text>
      </view>
    </view>
  </view>

  <view class="section-card menu-card" wx:if="{{userInfo}}">
    <view class="menu-item" bindtap="goToSmartCenter">
      <view class="menu-mark smart">智</view>
      <view class="menu-copy">
        <view class="menu-title">智慧中心</view>
        <view class="menu-desc">出勤画像、会议提醒与弱网同步</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToProxyApplications">
      <view class="menu-mark proxy">代</view>
      <view class="menu-copy">
        <view class="menu-title">代签申请</view>
        <view class="menu-desc">提交申请并查看审批进度</view>
      </view>
      <view class="menu-tail">
        <text class="pending-badge" wx:if="{{proxyPendingCount}}">{{proxyPendingCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToMyRecords">
      <view class="menu-mark primary">记</view>
      <view class="menu-copy">
        <view class="menu-title">我的签到记录</view>
        <view class="menu-desc">查看个人签到明细</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToStatistics">
      <view class="menu-mark success">统</view>
      <view class="menu-copy">
        <view class="menu-title">签到统计报表</view>
        <view class="menu-desc">查看会议出勤统计</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleLogout">
      <view class="menu-mark danger">退</view>
      <view class="menu-copy">
        <view class="menu-title logout-text">退出登录</view>
        <view class="menu-desc">清除当前账号登录状态</view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
