.profile-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.profile-panel {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-base);
  background: var(--bg-white);
  box-shadow: var(--shadow-base);
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  border: 1rpx solid #D9E5FF;
  border-radius: var(--radius-base);
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 650;
}

.avatar.muted {
  border-color: var(--border-light);
  background: var(--color-info-bg);
  color: var(--text-placeholder);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-account {
  overflow: hidden;
  margin-top: 7rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  color: var(--color-success);
  font-size: 21rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 0 6rpx var(--color-success-bg);
}

.login-link {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border: 1rpx solid #B8CCFA;
  border-radius: var(--radius-small);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.section-desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1rpx solid var(--border-extra-light);
}

.stats-grid .stat-item {
  position: relative;
  padding: 26rpx 8rpx 4rpx;
}

.stats-grid .stat-item:not(:last-child)::after {
  position: absolute;
  top: 28rpx;
  right: 0;
  width: 1rpx;
  height: 62rpx;
  background: var(--border-extra-light);
  content: '';
}

.stats-grid .stat-value {
  font-size: 34rpx;
}

.stats-grid .stat-item.rate .stat-value {
  color: var(--color-primary);
  font-size: 30rpx;
}

.section-heading.compact {
  margin-bottom: 14rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  min-height: 82rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-extra-light);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 25rpx;
}

.info-value {
  min-width: 0;
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.menu-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-extra-light);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item:active {
  background: var(--bg-soft);
}

.menu-mark {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-base);
  font-size: 24rpx;
  font-weight: 650;
}

.menu-mark.primary { background: var(--color-primary-bg); color: var(--color-primary); }
.menu-mark.proxy { background: var(--color-warning-bg); color: var(--color-warning); }
.menu-mark.smart { background: #E8F7F3; color: #0F766E; }
.menu-mark.success { background: var(--color-success-bg); color: var(--color-success); }
.menu-mark.danger { background: var(--color-danger-bg); color: var(--color-danger); }

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 5rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
}

.logout-text {
  color: var(--color-danger);
}

.menu-tail {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.pending-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 19rpx;
  background: var(--color-warning-bg);
  color: var(--color-warning);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 38rpx;
  text-align: center;
}

.menu-arrow {
  color: var(--text-placeholder);
  font-size: 38rpx;
  font-weight: 300;
}
