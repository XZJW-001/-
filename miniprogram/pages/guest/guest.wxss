.guest-page { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.meeting-band { display:grid; grid-template-columns:1fr 1fr; margin-bottom:24rpx; overflow:hidden; border-radius:var(--radius-base); background:#18212f; color:#fff; }.meeting-band view { display:flex; flex-direction:column; gap:10rpx; min-height:130rpx; padding:26rpx; }.meeting-band view:first-child { border-right:1rpx solid rgba(255,255,255,.12); }.meeting-band text { color:#9dacbe; font-size:21rpx; }.meeting-band strong { font-size:25rpx; line-height:1.45; word-break:break-all; }
.guest-form { margin-bottom:0; }.guest-form .form-item:last-of-type { margin-bottom:34rpx; }
.success-panel { min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }.success-mark { width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; margin-bottom:28rpx; border-radius:50%; background:var(--color-success); color:#fff; font-size:56rpx; }.success-title { color:var(--text-primary); font-size:40rpx; font-weight:650; }.success-desc { margin-top:12rpx; color:var(--text-secondary); font-size:26rpx; }.success-time { margin:18rpx 0 42rpx; padding:12rpx 20rpx; border-radius:var(--radius-small); background:var(--color-success-bg); color:var(--color-success); font-size:22rpx; }.success-panel .btn { max-width:520rpx; }
